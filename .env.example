# Supabase project the users' access tokens come from. The anon key is public
# (it ships in the web app too); data access is decided by each user's token
# and Row Level Security. Never put the service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Read by the Anthropic SDK.
ANTHROPIC_API_KEY=

# Optional overrides.
# COACH_MODEL=claude-opus-5-5
# COACH_EFFORT=low
# HISTORY_WEEKS=8
# CACHE_TTL_SECONDS=21600
# CORS_ORIGINS=https://forgerep.app,http://localhost:3000
